{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "conformance/**/*.ts", "examples/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "**/dist", ".local", "packages/inspector"]
}
